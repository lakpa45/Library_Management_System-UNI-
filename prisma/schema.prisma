generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Member {
  memberId   Int     @id @default(autoincrement())
  first_name String  @db.VarChar(100)
  last_name  String  @db.VarChar(100)
  email      String  @unique @db.VarChar(100)
  password   String  @db.VarChar(255)
  phone      String? @db.VarChar(20)
  issues     Issue[]
}

model Library {
  libraryId   Int        @id @default(autoincrement()) @map("library_id")
  libraryName String?    @map("library_name")
  librarianId Int?       @map("librarian_id")
  librarian   Librarian? @relation(fields: [librarianId], references: [librarianId])
  issues      Issue[]

  @@map("library")
}

model Librarian {
  librarianId Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  email       String  @unique @db.VarChar(100)
  password    String  @db.VarChar(255)
  phone       String? @db.VarChar(20)
  libraries   Library[]
}

model Category {
  categoryId   Int     @id @default(autoincrement()) @map("category_id")
  categoryName String  @map("category_name")
  description  String?
  books        Book[]

  @@map("category")
}

model Book {
  bookId     Int        @id @default(autoincrement()) @map("book_id")
  title      String
  isbn       String     @unique
  categoryId Int?       @map("category_id")
  category   Category?  @relation(fields: [categoryId], references: [categoryId])
  copies     BookCopy[]

  @@map("book")
}

model BookCopy {
  copyId  Int     @id @default(autoincrement()) @map("copy_id")
  barcode String  @unique
  status  String  // e.g. Available, Issued, Lost, Damaged
  bookId  Int     @map("book_id")
  book    Book    @relation(fields: [bookId], references: [bookId])
  issues  Issue[]

  @@map("book_copy")
}

model Issue {
  issueId    Int       @id @default(autoincrement()) @map("issue_id")
  issueDate  DateTime  @map("issue_date")
  dueDate    DateTime  @map("due_date")
  returnDate DateTime? @map("return_date")
  memberId   Int       @map("member_id")
  member     Member    @relation(fields: [memberId], references: [memberId])
  copyId     Int       @map("copy_id")
  bookCopy   BookCopy  @relation(fields: [copyId], references: [copyId])
  libraryId  Int?      @map("library_id")
  library    Library?  @relation(fields: [libraryId], references: [libraryId])

  @@map("issue")
}